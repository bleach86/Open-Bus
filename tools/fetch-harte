#!/bin/sh
# Fetch Tom Harte's 6502 family tests (SingleStepTests, MIT, not part of
# this repository): for the NMOS 6502 and the Synertek, Rockwell and WDC
# 65C02s, or those named (6502 synertek65c02 rockwell65c02 wdc65c02), each
# opcode they have (WDC's WAI and STP they haven't), into target/harte/
# and the set's name, where `cargo test --release harte` runs them against
# the CPU. Each opcode's JSON (10,000 cases) becomes a line a case, so the
# test reads it without a JSON parser:
#
#   pc s a x y p | addr value ... | pc s a x y p | addr value ... | addr value rw ...
#
# the state before, its memory, the state after, its memory, and each
# cycle's bus access: address, value, r or w (their count is the
# instruction's cycles).
set -e
cd "$(dirname "$0")/.."
sets=${*:-6502 synertek65c02 rockwell65c02 wdc65c02}
for set in $sets; do
    mkdir -p target/harte/$set
    cd target/harte/$set
    base=https://raw.githubusercontent.com/SingleStepTests/65x02/main/$set/v1
    for op in $(seq 0 255 | xargs printf '%02x '); do
        [ -f $op.txt ] && head -1 $op.txt | grep -q ' r ' && continue
        curl -sSfL -o $op.json "$base/$op.json" 2>/dev/null || { rm -f $op.json; continue; }
        [ -s $op.json ] || { rm -f $op.json; continue; } # left empty, as WAI and STP are
        python3 -I - $op.json $op.txt <<'PY'
import json, sys
with open(sys.argv[2], 'w') as out:
    for case in json.load(open(sys.argv[1])):
        def regs(s):
            return ' '.join(str(s[r]) for r in ('pc', 's', 'a', 'x', 'y', 'p'))
        def ram(s):
            return ' '.join(f'{a} {v}' for a, v in s['ram'])
        i, f = case['initial'], case['final']
        cycles = ' '.join(f'{c[0]} {c[1]} {c[2][0]}' for c in case['cycles'])
        out.write(f'{regs(i)} | {ram(i)} | {regs(f)} | {ram(f)} | {cycles}\n')
PY
        rm $op.json
    done
    cd - > /dev/null
done
echo "target/harte: ready; cargo test --release harte"
