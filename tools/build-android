#!/bin/sh
# Build the emulator for Android: libcpu_emu.so, the game screen's, with
# SDL's libSDL2.so (SDL built from sdl2-sys's own source, with the NDK); and
# the emulator's program, as the library app runs it for what it asks
# without a window, named libcpu_emu_exe.so for Android to install it with
# them. For each of Android's CPUs given (all four if none are), into
# desktop/gen/android/app/src/main/jniLibs/<ABI>/, where the app picks them
# up, beside the library app's own, as Tauri builds it. arm64-v8a is the
# NVIDIA Shield's; x86 an Android TV emulator's. Then the app itself, by
# Tauri: release, signed with the release key that
# desktop/gen/android/keystore.properties names, or the debug key without it;
# with --debug first, debuggable (run-as, the webview's inspector). Its APK
# is in desktop/gen/android/app/build/outputs/apk/universal/.
#
# Gradle wants JAVA_HOME a JDK 17. The SDK, NDK and CMake: as
# tools/android-env says.
set -e
cd "$(dirname "$0")/.."

PROFILE=
if [ "$1" = "--debug" ]; then
    PROFILE=--debug
    shift
fi

. tools/android-env
OUT=desktop/gen/android/app/src/main/jniLibs

ABIS=${*:-arm64-v8a armeabi-v7a x86 x86_64}
for abi in $ABIS; do
    android_target "$abi" || exit 1
    cargo build --release --lib --bin cpu_emu --target "$target"

    mkdir -p "$OUT/$abi"
    built=target/$target/release
    cp "$built/libcpu_emu.so" "$OUT/$abi/"
    cp "$built/cpu_emu" "$OUT/$abi/libcpu_emu_exe.so"
    # SDL; and hidapi, if SDL's build made it a library of its own.
    cp "$built/libSDL2.so" "$OUT/$abi/"
    if [ -f "$built/libhidapi.so" ]; then
        cp "$built/libhidapi.so" "$OUT/$abi/"
    fi
    for lib in libcpu_emu.so libcpu_emu_exe.so libSDL2.so libhidapi.so; do
        if [ -f "$OUT/$abi/$lib" ]; then
            "$TOOLS/llvm-strip" "$OUT/$abi/$lib"
        fi
    done
    echo "$abi: $(ls "$OUT/$abi" | tr '\n' ' ')"
done

# The app, for the same CPUs, by Tauri's names for them.
targets=
for abi in $ABIS; do
    case $abi in
        arm64-v8a) targets="$targets aarch64" ;;
        armeabi-v7a) targets="$targets armv7" ;;
        x86) targets="$targets i686" ;;
        x86_64) targets="$targets x86_64" ;;
    esac
done
export ANDROID_HOME="$SDK" NDK_HOME="$NDK"
if [ -z "$PROFILE" ] && [ ! -f desktop/gen/android/keystore.properties ]; then
    echo "build-android: no keystore.properties, so signed with the debug key:" \
        "it won't install over a release" >&2
fi
cd desktop
# The app's version, its Cargo.toml's: Tauri gives Android's APK one only from
# its own config, and without it every build is 1.0, version code 1.
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)
# shellcheck disable=SC2086
cargo tauri android build --apk $PROFILE --target $targets \
    --config "{\"version\": \"$version\"}"
