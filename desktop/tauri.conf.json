{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Bus",
  "identifier": "app.openbus.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Open Bus",
        "center": true,
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Old machines, emulated cycle by cycle: the NES, the Apple II, the Atari 2600 and 7800, and the Commander X16",
    "license": "GPL-3.0-or-later",
    "linux": {
      "deb": { "depends": ["libsdl2-2.0-0"] },
      "rpm": { "depends": ["SDL2"] }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
