{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Bus",
  "identifier": "app.openbus.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Open Bus",
        "center": true,
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Old machines, emulated cycle by cycle: the NES, the Apple II, the Atari 2600 and 7800, and the Commander X16",
    "license": "GPL-3.0-or-later",
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwRjAzOUM1NzBEOUVCRUYKUldUdjY5bHd4VG53WUw4YUtnRHBhSnB1NGpoVE51bHBjcHFUNkQ0cHRlWnEwY0d3RW03Q0dySTQK",
      "endpoints": [
        "https://github.com/bleach86/Open-Bus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
